do
    local airWalkEnabled = false
    local airWalkLockedY = nil
    local airWalkPlatform = nil
    local airWalkConn = nil
    local airWalkLastPos = nil
    local function destroyAirWalkPlatform()
        if airWalkPlatform then
            pcall(function() airWalkPlatform:Destroy() end)
            airWalkPlatform = nil
        end
    end
    local function stopAirWalk()
        if airWalkConn then airWalkConn:Disconnect() airWalkConn = nil end
        destroyAirWalkPlatform()
        airWalkLockedY = nil
        airWalkLastPos = nil
    end
    Tabs.SecondaryTab:Toggle({
        Title = "踏空行走",
        Value = false,
        Callback = function(state)
            airWalkEnabled = state
            if state then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then
                    WindUI:Notify({ Title = "踏空行走", Content = "未找到人物，开启失败", Duration = 3 })
                    airWalkEnabled = false
                    return
                end
                airWalkLockedY = root.Position.Y
                local footOffset = (hum.HipHeight or 2) + root.Size.Y / 2
                airWalkConn = RunService.Heartbeat:Connect(function()
                    if not airWalkEnabled then return end
                    local char2 = LocalPlayer.Character
                    local root2 = char2 and char2:FindFirstChild("HumanoidRootPart")
                    if not root2 then
                        destroyAirWalkPlatform()
                        airWalkLastPos = nil
                        return
                    end
                    local pos = root2.Position
                    if math.abs(pos.Y - airWalkLockedY) > 3 then
                        destroyAirWalkPlatform()
                        airWalkLastPos = nil
                        return
                    end
                    if airWalkLastPos and (Vector2.new(pos.X, pos.Z) - Vector2.new(airWalkLastPos.X, airWalkLastPos.Z)).Magnitude < 0.5 then
                        return
                    end
                    destroyAirWalkPlatform()
                    local platform = Instance.new("Part")
                    platform.Name = "AirWalkPlatform"
                    platform.Size = Vector3.new(6, 1, 6)
                    platform.Anchored = true
                    platform.CanCollide = true
                    platform.Transparency = 0.6
                    platform.Color = Color3.fromRGB(120, 120, 255)
                    platform.CFrame = CFrame.new(pos.X, airWalkLockedY - footOffset - 0.55, pos.Z)
                    platform.Parent = workspace
                    airWalkPlatform = platform
                    airWalkLastPos = pos
                end)
                WindUI:Notify({ Title = "踏空行走", Content = "已开启，锁定高度：" .. string.format("%.1f", airWalkLockedY), Duration = 3 })
                if state then kbPlayDing() end
            else
                stopAirWalk()
                WindUI:Notify({ Title = "踏空行走", Content = "已关闭", Duration = 3 })
                if state then kbPlayDing() end
            end
        end
    })
    LocalPlayer.CharacterAdded:Connect(function()
        if airWalkEnabled then
            stopAirWalk()
            airWalkEnabled = false
        end
    end)
end
