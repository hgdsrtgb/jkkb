local function startAntiFling()
    if AntiFlingConnection then AntiFlingConnection:Disconnect() end
    for _, p in ipairs(Players:GetPlayers()) do
        setupAntiFlingForPlayer(p)
    end
    local lastAntiFlingCheck = 0
    AntiFlingConnection = RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastAntiFlingCheck >= 0.5 then
            lastAntiFlingCheck = now
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    pcall(function()
                        for _, part in ipairs(p.Character:GetDescendants()) do
                            if part:IsA("BasePart") and part.CanCollide then
                                if antiFlingOriginalStates[part] == nil then
                                    antiFlingOriginalStates[part] = part.CanCollide
                                end
                                part.CanCollide = false
                            end
                        end
                    end)
                end
            end
        end
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                if root.AssemblyLinearVelocity.Magnitude > 100 then
                    root.AssemblyLinearVelocity = Vector3.zero
                end
                if root.AssemblyAngularVelocity.Magnitude > 20 then
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
    end)
end
local function stopAntiFling()
    if AntiFlingConnection then AntiFlingConnection:Disconnect() end
