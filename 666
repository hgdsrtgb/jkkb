kbInv2On = false
kbInvRealChar = nil
kbInvFakeChar = nil
kbInvOldFPDH = nil
kbInvRespawnConn = nil
kbInvTrans = {}
kbInvToggles = {}
kbShowHalfOn = false
function kbInvResetTrans()
    for part, orig in pairs(kbInvTrans) do
        pcall(function() if part and part.Parent then part.Transparency = orig end end)
    end
    kbInvTrans = {}
end
function kbInvApplyTrans(c)
    if not c then return end
    for _, v in ipairs(c:GetDescendants()) do
        if v:IsA("BasePart") then
            if kbInvTrans[v] == nil then kbInvTrans[v] = v.Transparency end
            v.Transparency = 0.5
        end
    end
end
function kbInvResetAll()
    kbSoulOn = false
    kbSoulOriginCF = nil
    kbInv1On = false
    kbInv2On = false
    if kbInvRespawnConn then pcall(function() kbInvRespawnConn:Disconnect() end) kbInvRespawnConn = nil end
    kbInvResetTrans()
    pcall(function() if kbInvFakeChar then kbInvFakeChar:Destroy() end end)
    kbInvFakeChar = nil
    kbInvRealChar = nil
    if kbInvOldFPDH then pcall(function() workspace.FallenPartsDestroyHeight = kbInvOldFPDH end) kbInvOldFPDH = nil end
end
function kbInvSetup()
    if kbInvFakeChar and kbInvFakeChar.Parent then return true end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        WindUI:Notify({Title = "提示", Content = "角色未加载", Duration = 3})
        return false
    end
    pcall(function() char.Archivable = true end)
    local ok, clone = pcall(function() return char:Clone() end)
    if not ok or not clone then
        WindUI:Notify({Title = "提示", Content = "克隆失败，当前注入器不支持", Duration = 3})
        return false
    end
    kbInvOldFPDH = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = 0/0
    kbInvRealChar = char
    clone.Parent = workspace
    LocalPlayer.Character = clone
    kbInvFakeChar = clone
    pcall(function()
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") then
                v.Transparency = kbShowHalfOn and 0.5 or 1
            end
        end
    end)
    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then workspace.CurrentCamera.CameraSubject = hum end
    kbInvRespawnConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
        local had = kbInvFakeChar ~= nil or kbInvRealChar ~= nil
        kbInvResetAll()
        pcall(function() for _, t in pairs(kbInvToggles) do t:Set(false) end end)
        if had then
            task.spawn(function()
                task.wait(0.5)
                local h = newChar and newChar:FindFirstChildOfClass("Humanoid")
                if h then workspace.CurrentCamera.CameraSubject = h end
            end)
        end
    end)
    return true
end
function kbInvCheckRestore()
    if kbSoulOn or kbInv1On or kbInv2On then return end
    local fake = kbInvFakeChar
    local real = kbInvRealChar
    local backCF = nil
    if fake and fake.Parent then
        local h = fake:FindFirstChild("HumanoidRootPart")
        if h then backCF = h.CFrame end
    end
    if kbInvRespawnConn then pcall(function() kbInvRespawnConn:Disconnect() end) kbInvRespawnConn = nil end
    kbInvResetTrans()
    pcall(function() if fake then fake:Destroy() end end)
    kbInvFakeChar = nil
    kbInvRealChar = nil
    if kbInvOldFPDH then pcall(function() workspace.FallenPartsDestroyHeight = kbInvOldFPDH end) kbInvOldFPDH = nil end
    if real and real.Parent ~= nil then
        pcall(function() real.Parent = workspace end)
        LocalPlayer.Character = real
        if backCF then pcall(function() real:MoveTo(backCF.Position) end) end
        local hum = real:FindFirstChildOfClass("Humanoid")
        if hum then workspace.CurrentCamera.CameraSubject = hum end
    end
end
