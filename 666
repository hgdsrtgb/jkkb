kbCurrentBg = nil
kbApplyBackground = function(name)
    if name == "默认背景图" then
        local ok, err = pcall(function()
            local bg = Window.UIElements.Main.Background
            local img = bg:FindFirstChild("KbBgImage")
            if img then img:Destroy() end
        end)
        if ok then
            kbCurrentBg = name
            WindUI:Notify({ Title = "切换背景图", Content = "已切换为：" .. name, Duration = 3 })
        else
            WindUI:Notify({ Title = "切换背景图", Content = "切换失败", Duration = 3 })
        end
        return
    end
    local kbBgUrls = {
        ["eva背景图"] = "https://raw.githubusercontent.com/kongbaNB/TB/refs/heads/main/Image_1785339712342_469.jpg",
        ["银花背景图1"] = "https://raw.githubusercontent.com/kongbaNB/TB/refs/heads/main/Image_1785339143310_475.jpg",
        ["银花背景图2"] = "https://raw.githubusercontent.com/kongbaNB/TB/refs/heads/main/Image_1785339141889_101.jpg",
        ["银花背景图3"] = "https://raw.githubusercontent.com/kongbaNB/TB/refs/heads/main/Image_1785339140644_893.jpg",
        ["白子背景图"] = "https://raw.githubusercontent.com/kongbaNB/TB/refs/heads/main/Image_1785395257153_996.jpg",
    }
    local kbSetBgImage = function(asset)
        local bg = Window.UIElements.Main.Background
        local img = bg:FindFirstChild("KbBgImage")
        if not img then
            img = Instance.new("ImageLabel")
            img.Name = "KbBgImage"
            img.BackgroundTransparency = 1
            img.Size = UDim2.new(1, 0, 1, 0)
            img.ScaleType = Enum.ScaleType.Crop
            img.ImageTransparency = 0
            img.ZIndex = 1
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, Window.UICorner or 16)
            corner.Parent = img
            img.Parent = bg
        end
        img.Image = asset
        img.Visible = true
        pcall(function() Window:SetBackgroundImage(asset) end)
    end
    if name == "恐脚本背景图" then
        local ok, err = pcall(function()
            kbSetBgImage("rbxassetid://113517588654522")
        end)
        if ok then
            kbCurrentBg = name
            WindUI:Notify({ Title = "切换背景图", Content = "已切换为：" .. name, Duration = 3 })
        else
            WindUI:Notify({ Title = "切换背景图", Content = "切换失败", Duration = 3 })
        end
        return
    end
    if kbBgUrls[name] then
        local ok, err = pcall(function()
            local fileName = "恐脚本/bg_" .. name .. ".jpg"
            if makefolder and not isfolder("恐脚本") then makefolder("恐脚本") end
            if not (isfile and isfile(fileName)) then
                local data = game:HttpGet(kbBgUrls[name])
                writefile(fileName, data)
            end
            local asset = getcustomasset(fileName)
            kbSetBgImage(asset)
        end)
        if ok then
            kbCurrentBg = name
            WindUI:Notify({ Title = "切换背景图", Content = "已切换为：" .. name, Duration = 3 })
        else
            WindUI:Notify({ Title = "切换背景图", Content = "切换失败", Duration = 3 })
        end
    end
end
